# ==============================================================================
# FoodBridge Terraform Variables Example
# Copy this file to terraform.tfvars and customize with your own values.
# NEVER commit terraform.tfvars containing sensitive data to version control.
# ==============================================================================

# AWS Region (Mumbai by default)
aws_region = "ap-south-1"

# Dedicated AWS CLI Profile
aws_profile = "foodbridge-personal"

# Environment identifier
environment = "dev"

# Project naming prefix
project_name = "FoodBridge"

# Network CIDRs
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidr    = "10.0.1.0/24"
private_subnet_a_cidr = "10.0.2.0/24"
private_subnet_b_cidr = "10.0.3.0/24"

# Availability Zones in ap-south-1
availability_zones = [
  "ap-south-1a",
  "ap-south-1b"
]

# Restrict SSH (port 22) access to your specific public IP address.
# Replace with your current public IP (e.g., "203.0.113.25/32").
# WARNING: 0.0.0.0/0 is explicitly rejected by validation.
trusted_ssh_cidr = "203.0.113.25/32"

# Resource Tags
default_tags = {
  Project     = "FoodBridge"
  ManagedBy   = "Terraform"
  Environment = "dev"
}

# EC2 Web Server Configuration (Step 7)
instance_type    = "t3.micro"
ec2_ami_id       = "ami-065d2b03fb493085a"
root_volume_size = 20
ssh_key_name     = "redminekeypair"

